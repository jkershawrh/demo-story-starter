{
  "name": "demo-story-starter-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix template run dev",
    "build": "npm --prefix template run build",
    "test": "npm --prefix template run test",
    "check": "npm run validate:blueprint -- examples/triforce-reference/demo-blueprint.yaml && npm run test:bootstrap && npm --prefix template run check",
