{
  "name": "demo-story-starter-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix template run dev",
    "build": "npm --prefix template run build",
    "test": "npm --prefix template run test",
    "check": "npm run validate:blueprint -- examples/triforce-reference/demo-blueprint.yaml && npm run validate:handoff -- --template handoff/launchpad-handoff.example.yaml && npm run validate:vef-adapter && npm run validate:catalog && npm run test:handoff && npm run test:vef-adapter && npm run test:catalog && npm run verify:catalog-generated && npm run test:bootstrap && npm --prefix template run check",
    "bootstrap": "node --experimental-strip-types skills/demo-story-builder/scripts/bootstrap-demo.ts",
    "test:bootstrap": "node scripts/test-bootstrap.mjs",
    "scaffold": "node --experimental-strip-types skills/demo-story-builder/scripts/scaffold-demo.ts",
    "discover": "node --experimental-strip-types skills/demo-story-builder/scripts/discover-demo.ts",
    "validate:blueprint": "node --experimental-strip-types skills/demo-story-builder/scripts/validate-blueprint.ts",
    "validate:handoff": "node --experimental-strip-types skills/demo-story-builder/scripts/validate-handoff.ts",
    "validate:vef-adapter": "node --experimental-strip-types skills/demo-story-builder/scripts/validate-vef-adapter.ts contracts/vef/launchpad-adapter-conformance.yaml",
    "test:handoff": "node scripts/test-handoff.mjs",
    "test:vef-adapter": "node scripts/test-vef-adapter.mjs",
    "validate:catalog": "node scripts/validate-catalog-portfolio.mjs",
    "generate:catalog": "node scripts/generate-catalog-assets.mjs",
    "test:catalog": "node scripts/test-catalog-portfolio.mjs",
    "verify:catalog-generated": "node scripts/verify-catalog-assets.mjs",
    "install-skill": "node scripts/install-skill.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  }
}
