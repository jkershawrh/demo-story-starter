    "scaffold": "node --experimental-strip-types skills/demo-story-builder/scripts/scaffold-demo.ts",
    "discover": "node --experimental-strip-types skills/demo-story-builder/scripts/discover-demo.ts",
    "validate:blueprint": "node --experimental-strip-types skills/demo-story-builder/scripts/validate-blueprint.ts",
    "install-skill": "node scripts/install-skill.mjs"
  }
}
